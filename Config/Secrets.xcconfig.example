# Copy this file to Secrets.xcconfig and enter the public Supabase project values.
# Use the slash setting to keep the URL's // from being parsed as an xcconfig comment.
# Never put a service_role key or another privileged server secret in the app.
SUPABASE_PROJECT_URL = https:$(SUPABASE_URL_SLASH)$(SUPABASE_URL_SLASH)your-project.supabase.co
SUPABASE_ANON_KEY = ""
