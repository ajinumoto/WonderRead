    },
    "Apple's on-device AI creates story text only. It doesn't generate illustrations with this method. Model availability and safety checks follow Apple's built-in support; the app can't enable or bypass device, region, language, or system-service requirements." : {
      "comment" : "Localized app copy.",
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI Apple di perangkat membuat teks cerita saja. Ilustrasi tidak dibuat dengan metode ini. Ketersediaan model dan pemeriksaan keamanan mengikuti dukungan bawaan Apple; aplikasi tidak dapat mengaktifkan atau melewati batasan perangkat, wilayah, bahasa, maupun layanan sistem."
          }
        }
      }
    },
